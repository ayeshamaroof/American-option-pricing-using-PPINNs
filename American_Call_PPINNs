def exact_solution(x,sigma,r ,t): #for result evaluation
    tau = t
    d1 = (np.log(x / K) + (r + 0.5 * sigma ** 2) * tau) / (sigma * np.sqrt(tau))
    d2 = d1 - sigma * np.sqrt(tau)

    call = x * si.norm.cdf(d1, 0.0, 1.0) - K * np.exp(-r * tau) * si.norm.cdf(d2, 0.0, 1.0)
    return call


def evaluate_against_exact(estimator_func, exact_func,
                           N_pool=130000, N_eval=100000, K=1,
                           xmin=[0,0,0], xmax=[2,1,0.3],
                           threshold=0, seed=None,
                           label="PINN"):

    if seed is not None:
        np.random.seed(seed)

    # gen dataset for error comparison, we are generating more than required so that we still 
    #have same data set size even after dropping. better to report in paper
    geom = dde.geometry.geometry_3d.Cuboid(xmin=xmin, xmax=xmax)
    timedomain = dde.geometry.TimeDomain(0, 1)
    geomtime = dde.geometry.GeometryXTime(geom, timedomain)
    X_pool = geomtime.random_points(N_pool)

    # TRUE SOLUTION
    y_exact_pool = np.zeros(N_pool)
    start = tm.time()
    for i in range(N_pool):
        y_exact_pool[i] = exact_func(float(X_pool[i,0]),
                                     float(X_pool[i,1]),
                                     float(X_pool[i,2]),
                                     float(X_pool[i,3]))
    end = tm.time()
    avg_time_exact = (end - start) / N_pool
    print(f"[Exact] Average computation time per option: {avg_time_exact*1e6:.2f} μs")

    # Filter  
    mask = y_exact_pool > threshold
    n_valid = int(mask.sum())
    print(f"Pool: {N_pool}, valid after filtering: {n_valid}, dropped: {N_pool - n_valid}")

    if n_valid < N_eval:
        raise ValueError(f"Only {n_valid} valid points, need {N_eval}. Increase N_pool.")

    #  Keeping exactly N_eval valid points
    X = X_pool[mask][:N_eval]
    y_exact_f = y_exact_pool[mask][:N_eval]

    # PREDICTED SOLUTION
    y_est_f = np.zeros(N_eval)
    start = tm.time()
    for i in range(N_eval):
        y_est_f[i] = estimator_func(float(X[i,0]),
                                    float(X[i,1]),
                                    float(X[i,2]),
                                    float(X[i,3]))
    end = tm.time()
    avg_time_est = (end - start) / N_eval
    print(f"[{label}] Average computation time per option: {avg_time_est*1e6:.2f} μs")

    # Metrics 
    mse = dde.metrics.mean_squared_error(y_exact_f, y_est_f)
    rmse = np.sqrt(mse)
    mape = dde.metrics.mean_absolute_percentage_error(y_exact_f, y_est_f)
    ape_std = dde.metrics.absolute_percentage_error_std(y_exact_f, y_est_f)
    l2_rel = dde.metrics.l2_relative_error(y_exact_f, y_est_f)
    nanl2 = dde.metrics.nanl2_relative_error(y_exact_f, y_est_f)
    r2 = r2_score(y_exact_f, y_est_f)

    print(f"\n--- {label} vs Exact (n = {N_eval}) ---")
    print(f"RMSE = {rmse:.6f}")
    print(f"MAPE = {mape:.6f}")
    print(f"Absolute % Error Std = {ape_std:.6f}")
    print(f"L2 Relative Error = {l2_rel:.6f}")
    print(f"NaN L2 Relative Error = {nanl2:.6f}")
    print(f"R² = {r2:.6f}")

    # Error histogram
    error = y_exact_f - y_est_f
    plt.figure(figsize=(7,5))
    sns.histplot(error, bins=50, kde=True, alpha=0.7)
    plt.xlabel("Error (Exact - Estimate) per strike", fontsize=12)
    plt.ylabel("Density", fontsize=12)
    plt.title(f"Histogram of Error: {label} vs Exact", fontsize=13)
    plt.grid(True, linestyle='--', alpha=0.6)
    plt.tight_layout()
    plt.show()

    return y_exact_f, y_est_f


def main():
  #THIS is the main code block for P-PINNs"
#tried not used 2 is better
    def payoff_tf1(x):
        S = x[:, 0:1]                 # single underlying
        payoff = tf.nn.relu(S - K)    # max(S-K, 0)
        return payoff

    def payoff_tf2(x):
        tau_sm=0.0001 #tune
        S = x[:, 0:1]
        smooth_payoff = tau_sm * tf.math.softplus((S - K) / tau_sm)
        return smooth_payoff

    def pde(x, y):
        #x=(stock,sigma,time)
        dy_x = dde.grad.jacobian(y, x, i=0, j=0)
        dy_t = dde.grad.jacobian(y, x, i=0, j=3)
        dy_xx = dde.grad.hessian(y, x, i=0, j=0)
        dy_dt=dy_t-0.5*x[:, 1:2]**2*x[:, 0:1]**2*dy_xx-x[:, 2:3]*x[:, 0:1]*dy_x+x[:, 2:3]*y
        g=payoff_tf2(x[:, 0:1])
        #g=tf.maximum(x[:, 0:1]-1,0)
        pde=tf.minimum(dy_dt,(y-g))
        return pde

    def func(x):
        return np.maximum(x[:, 0:1]-1, 0)

    def funcZ(x):
        return 0

    def exact_call(S0, sigma, r, tau, K=1):
        T = tau
        if T <= 0:
            return max(S0 - K, 0.0)
        d1 = (np.log(S0 / K) + (r + 0.5 * sigma**2) * T) / (sigma * np.sqrt(T))
        d2 = d1 - sigma * np.sqrt(T)
        price = S0 * norm.cdf(d1) - K * np.exp(-r * T) * norm.cdf(d2)
        return float(price)

    def funcExact(x):
        S   = x[:, 0:1]   # stock
        sig = x[:, 1:2]   # sigma
        ra  = x[:, 2:3]   # r
        ta  = x[:, 3:4]   # tau
        values = []
        for i in range(x.shape[0]):
            price = exact_call(
                float(S[i,0]),
                float(sig[i,0]),
                float(ra[i,0]),
                float(ta[i,0]),
            )
            values.append(price)

        values = np.array(values).reshape(-1,1)  # shape (N,1)

        return values


    ### defining the limits of domain b means upper boundry, m is lower boundry
    bstock=2
    bsigma=1
    br=0.3
    m=0.0

    xmin = [0,m,m]
    xmax = [bstock,bsigma,br]
    geom = dde.geometry.geometry_3d.Cuboid(xmin=xmin, xmax=xmax)

    timedomain = dde.geometry.TimeDomain(0, 1)
    geomtime = dde.geometry.GeometryXTime(geom, timedomain)

    # following are the boundry for hybrid scheme that we check, used only the optimal combination

    bc1 = dde.DirichletBC(geomtime, funcZ, lambda x, _: np.isclose(x[0], m))
    bc2 = dde.DirichletBC(geomtime, funcExact, lambda x, _: np.isclose(x[0], bstock))

    bcs1 = dde.DirichletBC(geomtime, funcExact, lambda x, _: np.isclose(x[1], m))
    bcs2 = dde.DirichletBC(geomtime, funcExact, lambda x, _: np.isclose(x[1], bsigma))

    bcr1 = dde.DirichletBC(geomtime, funcExact, lambda x, _: np.isclose(x[2], m))
    bcr2 = dde.DirichletBC(geomtime, funcExact, lambda x, _: np.isclose(x[2], br))

    ic = dde.IC(geomtime, func, lambda _, on_initial: on_initial)

    
    bc=[ic,bc1,bcs1,bcr1] #,bcs2,bcr2,bc2]

    # following is the extra collocation points
    c=5

    X_to_domain = np.column_stack([
        np.random.uniform(0, bstock, 100*c),
        np.random.uniform(0, bsigma, 100*c),
        np.random.uniform(0, br, 100*c),
        np.random.uniform(0.0, 0.05, 100*c)
    ])

    X_extra = np.vstack([X_to_domain])

    # final defination of network
    data = dde.data.TimePDE(
        geomtime, pde, bc, num_domain=2000*c,
        num_boundary=200*c, num_initial=100*c, num_test=2540*c,anchors=X_extra
        )


    net = dde.nn.FNN([4] + [60] * 6+[1], "tanh", "Glorot normal")#tanh

    model = dde.Model(data, net)
    lenbc=len(bc)-1
    # Build and train the model:
    model.compile("adam", lr=0.0001, loss_weights=[1,5]+[1]*lenbc)
    model.train(iterations=10000)
    model.compile("L-BFGS",loss_weights=[1,5]+[1]*lenbc)
    losshistory, train_state = model.train()

    # train_state.best_y = train_state.best_y.reshape(-1, 1)
    dde.saveplot(losshistory, train_state, issave=True, isplot=True)

      ################## end of hybrid ppinn block#######################
