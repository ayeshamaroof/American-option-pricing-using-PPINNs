    r_to_domain = np.random.uniform(m,br, N_to_domain)
    t_domain = np.random.uniform(0.0, 0.05, N_to_domain)
    X_to_domain = np.column_stack([S_to_domain,sig_to_domain,r_to_domain,t_domain])

    X_extra = np.vstack([X_to_domain])
    # Define the PDE problem and configurations of the network:
    data = dde.data.TimePDE(
        geomtime, pde, bc, num_domain=2000*c,
        num_boundary=200*c, num_initial=100*c,
        anchors=X_extra
        )

    net = dde.nn.FNN([4] + [40] * 4+[1], "tanh", "Glorot uniform")#tanh

    model = dde.Model(data, net)
    lenbc=len(bc)-1
    # Build and train the model:
    model.compile("adam", lr=0.0001, loss_weights=[7,1]+[1]*lenbc)
    model.train(iterations=10000)
