    geom = dde.geometry.geometry_3d.Cuboid(xmin=xmin, xmax=xmax)

    timedomain = dde.geometry.TimeDomain(0, 1)
    geomtime = dde.geometry.GeometryXTime(geom, timedomain)


    bc1 = dde.DirichletBC(geomtime, func_FD, lambda x, _: np.isclose(x[0], ms))
    bc2 = dde.DirichletBC(geomtime, func_FD, lambda x, _: np.isclose(x[0], bstock))

    bcs1 = dde.DirichletBC(geomtime, func_FD, lambda x, _: np.isclose(x[1], m))
    bcs2 = dde.DirichletBC(geomtime, func_FD, lambda x, _: np.isclose(x[1], bsigma))

    bcr1 = dde.DirichletBC(geomtime, func_FD, lambda x, _: np.isclose(x[2], m))
    bcr2 = dde.DirichletBC(geomtime, func_FD, lambda x, _: np.isclose(x[2], br))

    ic = dde.IC(geomtime, func, lambda _, on_initial: on_initial)

    # Define the PDE problem and configurations of the network:
    bc=[ic,bc1,bcs1,bcr1] #,bcr2,bc2]bc2,bcs1,bcr1

    c=5
