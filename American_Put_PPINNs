    # -------------------------------
    # General evaluation function
    # -------------------------------
    def evaluate_against_exact(estimator_func, exact_func,
                               N_pool=150000, N_eval=100000, K=1,
                               xmin=[0.0001, 0, 0], xmax=[2, 1, 0.3],
                               label="PINN"):

  
        # Generate extra random points
        geom = dde.geometry.geometry_3d.Cuboid(xmin=xmin, xmax=xmax)
        timedomain = dde.geometry.TimeDomain(0, 1)
        geomtime = dde.geometry.GeometryXTime(geom, timedomain)
        X_pool = geomtime.random_points(N_pool)

        # Compute ref_FD 400 prices for all 200,000 points
        #    ONLY to identify zero-price observations
        
        y_exact_pool = np.zeros(N_pool)
        start = tm.time()
        for i in range(N_pool):
            y_exact_pool[i] = exact_func(
                float(X_pool[i, 0]),
                float(X_pool[i, 1]),
                float(X_pool[i, 2]),
                float(X_pool[i, 3])
            )

        end = tm.time()

        avg_time_exact = (end - start) / N_pool

        print(f"[Exact] Average computation time per option: "
              f"{avg_time_exact * 1e6:.2f} μs")


        # FRilteration
        valid_indices = np.where(y_exact_pool > 0)[0]

        n_valid = len(valid_indices)
        n_dropped = N_pool - n_valid

        print(f"[{label}] Exact price = 0: dropped {n_dropped} points")
        print(f"[{label}] Valid points remaining: {n_valid}")

        if n_valid < N_eval:
            raise ValueError(
                f"Only {n_valid} points have exact price > 0, "
                f"but {N_eval} are required."
            )

        # Keep 100,000 this is better for reporting in paper
        valid_indices = valid_indices[:N_eval]

        X = X_pool[valid_indices]
        y_exact = y_exact_pool[valid_indices]

        print(f"[{label}] Using {N_eval} valid points for error calculation.")

        # PPINNs calculation
        y_est = np.zeros(N_eval)

        start = tm.time()

        for i in range(N_eval):
            y_est[i] = estimator_func(
                float(X[i, 0]),
                float(X[i, 1]),
                float(X[i, 2]),
                float(X[i, 3])
            )

        end = tm.time()

        avg_time_est = (end - start) / N_eval

        print(f"[{label}] Average computation time per option: "
              f"{avg_time_est * 1e6:.2f} μs")


        # Metrics
       
        mse = dde.metrics.mean_squared_error(y_exact, y_est)
        rmse = np.sqrt(mse)

        mape = dde.metrics.mean_absolute_percentage_error(
            y_exact, y_est
        )

        ape_std = dde.metrics.absolute_percentage_error_std(
            y_exact, y_est
        )

        l2_rel = dde.metrics.l2_relative_error(
            y_exact, y_est
        )

        nanl2 = dde.metrics.nanl2_relative_error(
            y_exact, y_est
        )

        r2 = r2_score(y_exact, y_est)

        print(f"\n--- {label} vs Exact ---")
        print(f"RMSE = {rmse:.7f}")
        print(f"MAPE = {mape:.7f}")
        print(f"Absolute % Error Std = {ape_std:.7f}")
        print(f"L2 Relative Error = {l2_rel:.7f}")
        print(f"NaN L2 Relative Error = {nanl2:.7f}")
        print(f"R² = {r2:.7f}")

    
        # Error histogram
        
        error = y_exact - y_est

        plt.figure(figsize=(7, 5))
        sns.histplot(error, bins=50, kde=True, alpha=0.7)

        plt.xlabel("Error (Exact - Estimator) per strike", fontsize=12)
        plt.ylabel("Density", fontsize=12)
        plt.title(
            f"Histogram of Error: {label} vs Exact",
            fontsize=13
        )

        plt.grid(True, linestyle='--', alpha=0.6)
        plt.tight_layout()
        plt.show()

        return y_exact, y_est

    # PPINN wrapper
