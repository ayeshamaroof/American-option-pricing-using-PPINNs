    start_PP = tm.time()

    def payoff_tf1(x):
        S = x[:, 0:1]                 # single underlying
        payoff = tf.nn.relu(S - K)    # max(S-K, 0)
        return payoff

    def payoff_tf2(x):
        tau_sm=0.0001 #tune
        S = x[:, 0:1]
        smooth_payoff = tau_sm * tf.math.softplus((1-S) / tau_sm)
        return smooth_payoff

    def pde(x, y):
        #x=(stock,sigma,time)
        dy_x = dde.grad.jacobian(y, x, i=0, j=0)
        dy_t = dde.grad.jacobian(y, x, i=0, j=3)
        dy_xx = dde.grad.hessian(y, x, i=0, j=0)
        dy_dt=dy_t-0.5*x[:, 1:2]**2*x[:, 0:1]**2*dy_xx-x[:, 2:3]*x[:, 0:1]*dy_x+x[:, 2:3]*y
        g=payoff_tf2(x[:, 0:1])
        #g=tf.maximum(x[:, 0:1]-1,0)
        pde=tf.minimum(dy_dt,(y-g))
        return pde

    def func(x):
        return np.maximum(1-x[:, 0:1], 0)

    def funcZ(x):
        return 0



    def func_FD(x):
    # unpack inputs (each is (N,1))
        S   = x[:, 0:1]   # stock
        sig = x[:, 1:2]   # sigma
        ra  = x[:, 2:3]   # r
        ta  = x[:, 3:4]   # tau

        # compute price for each point
        values = []
        for i in range(x.shape[0]):
            price = ref_solution(
                float(S[i,0]),
                float(sig[i,0]),
                float(ra[i,0]),
                float(ta[i,0]),
            )
            values.append(price)

        values = np.array(values).reshape(-1,1)  # shape (N,1)

        return values


    ###h
    bstock=2
