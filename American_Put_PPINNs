def ref_solution(S0, sigma, r, T, K=1, grid_size=400): #FD using quant fin

    S0, sigma, r, T = map(float, [S0, sigma, r, T])

    ql.Settings.instance().evaluationDate = ql.Date.todaysDate()

    day_count = ql.Actual365Fixed()
    calendar = ql.NullCalendar()
    maturity_date = ql.Settings.instance().evaluationDate + int(T * 365)

    payoff = ql.PlainVanillaPayoff(ql.Option.Put, K)
    exercise = ql.AmericanExercise(
        ql.Settings.instance().evaluationDate,
        maturity_date
    )

    option = ql.VanillaOption(payoff, exercise)

    spot = ql.QuoteHandle(ql.SimpleQuote(S0))
    rate = ql.YieldTermStructureHandle(
        ql.FlatForward(0, calendar, r, day_count)
    )
    vol = ql.BlackVolTermStructureHandle(
        ql.BlackConstantVol(0, calendar, sigma, day_count)
    )

    process = ql.BlackScholesProcess(spot, rate, vol)

    # grid now controlled externally so this can be used for different 100,200,400,800 size
    engine = ql.FdBlackScholesVanillaEngine(
        process, grid_size, grid_size
    )

    option.setPricingEngine(engine)

    return option.NPV()

def ref_solution1(S0, sigma, r, T, K=1,
                             steps=50,
                             paths=100000,
                             seed=42): #MC-LSM using quant fin


    S0, sigma, r, T = map(float, [S0, sigma, r, T])

    today = ql.Date.todaysDate()
    ql.Settings.instance().evaluationDate = today

    day_count = ql.Actual365Fixed()
    calendar = ql.NullCalendar()
    maturity_date = today + int(T * 365)

    payoff = ql.PlainVanillaPayoff(ql.Option.Put, K)
    exercise = ql.AmericanExercise(today, maturity_date)
    option = ql.VanillaOption(payoff, exercise)

    spot = ql.QuoteHandle(ql.SimpleQuote(S0))
    rate = ql.YieldTermStructureHandle(
        ql.FlatForward(today, r, day_count)
    )
    vol = ql.BlackVolTermStructureHandle(
        ql.BlackConstantVol(today, calendar, sigma, day_count)
    )

    process = ql.BlackScholesProcess(spot, rate, vol)

    engine = ql.MCAmericanEngine(
        process,
        "PseudoRandom",
        timeSteps=steps,
        requiredSamples=paths,
        seed=seed
    )

    option.setPricingEngine(engine)

    return option.NPV()



